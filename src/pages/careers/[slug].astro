---
import Base from '../../layouts/Base.astro';
import { JobPage } from '../../components/pages/JobPage';
import { VACANCIES } from '../../data/vacancies';

export function getStaticPaths() {
  return VACANCIES.map((v) => ({
    params: { slug: v.slug },
    props: { vacancy: v },
  }));
}

const { vacancy } = Astro.props;
---

<Base
  title={`${vacancy.title} - Careers at Lambs Group`}
  description={vacancy.summary}
  job={{
    title: vacancy.title,
    description: [vacancy.summary, ...vacancy.responsibilities, ...vacancy.requirements].join(' '),
    datePosted: vacancy.datePosted,
    validThrough: vacancy.validThrough,
    employmentType: vacancy.type,
    location: vacancy.location,
  }}
>
  <JobPage vacancy={vacancy} client:load />
</Base>
