---
import Base from "../layouts/Base.astro";
import { PrivateWorksPage } from "../components/pages/PrivateWorksPage";
import { SERVICE_GROUPS } from "../components/pages/private/serviceGroups";
---
<Base
  service={{
    name: 'Private works: home improvements and groundworks',
    serviceType: 'Domestic brickwork, landscaping and drainage',
    description: 'Brickwork, patios and landscaping, fencing and drainage for homeowners across the North West.',
    items: SERVICE_GROUPS.map((s) => ({ name: s.title, description: s.blurb })),
  }}
  title="Private Works: Brickwork & Landscaping | Lambs Group"
  description="Brickwork, patios and landscaping, fencing and drainage from Lambs Group. Family-run since 1988, with clear written quotations."
>
  <PrivateWorksPage client:load />
</Base>
