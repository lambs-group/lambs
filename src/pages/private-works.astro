---
import Base from "../layouts/Base.astro";
import { PrivateWorksPage } from "../components/pages/PrivateWorksPage";
import { SERVICE_GROUPS } from "../components/pages/private/serviceGroups";
---
<Base
  service={{
    name: 'Private works: home improvements and groundworks',
    serviceType: 'Domestic building, joinery and groundworks',
    description: 'Driveways, patios, groundworks, building works, roofing, windows and doors, joinery, plumbing and electrical works for homeowners across the North West.',
    items: SERVICE_GROUPS.map((s) => ({ name: s.title, description: s.blurb })),
  }}
  title="Private Works: Building, Joinery & Groundworks | Lambs Group"
  description="Driveways, patios, groundworks, building, roofing, windows and doors, joinery, plumbing and electrical works from Lambs Group. Family-run since 1988, with clear written quotations."
>
  <PrivateWorksPage client:load />
</Base>
