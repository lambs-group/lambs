---
import '../styles/global.css';
// Inter is self-hosted (no Google Fonts request, so no visitor IPs sent to Google).
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import { ClientRouter } from 'astro:transitions';
import { PageTransition } from '../components/PageTransition';
import { CookieConsent } from '../components/CookieConsent';
import { buildGraph, type PageSchemaType, type ServiceInput, type FaqInput, type JobInput } from '../utils/schema';
import lastmod from '../data/sitemap-lastmod.json';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemaType?: PageSchemaType;
  service?: ServiceInput;
  faq?: FaqInput[];
  job?: JobInput;
}

const {
  title,
  description = 'Lambs Group - Infrastructure services across the UK since 1988. Telecoms, utilities and private works. Family-run, skilled teams across our workforce, compliance-first.',
  ogImage = '/images/og-default.jpg',
  type = 'website',
  noindex = false,
  schemaType,
  service,
  faq,
  job,
} = Astro.props;

// Only the production domain should be indexed. Preview hosts (e.g. github.io)
// get noindex automatically; this flips off when `site` is set to lambsgroup.co.uk.
const isProduction = /(^|\.)lambsgroup\.co\.uk$/.test(Astro.site?.hostname ?? '');
const robotsNoindex = noindex || !isProduction;
const usesDefaultOg = ogImage === '/images/og-default.jpg';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImageURL = new URL(ogImage.startsWith('/') ? `${baseUrl}${ogImage}` : ogImage, Astro.site);

// Structured data (JSON-LD). Path is relative to the site root, with slashes either side.
const siteRoot = new URL(`${baseUrl}/`, Astro.site).href;
const pagePath = ('/' + Astro.url.pathname.replace(baseUrl, '').replace(/^\/+|\/+$/g, '') + '/').replace('//', '/');
const jsonLd = buildGraph({
  siteRoot,
  pageUrl: new URL(pagePath.slice(1), siteRoot).href,
  path: pagePath,
  title,
  description,
  ogImage: ogImageURL.href,
  schemaType,
  dateModified: (lastmod as Record<string, string>)[pagePath],
  service,
  faq,
  job,
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#264A88" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robotsNoindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {usesDefaultOg && <meta property="og:image:width" content="1200" />}
    {usesDefaultOg && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content="Lambs Group - infrastructure services across the UK. Telecoms, utilities and private works." />
    <meta property="og:site_name" content="Lambs Group" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Lambs Group - infrastructure services across the UK. Telecoms, utilities and private works." />

    <!-- Favicon -->
    <link rel="icon" href={`${baseUrl}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl}/favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}/apple-touch-icon.png`} />

    <!-- JSON-LD: business, website, page, breadcrumbs, service/FAQ/job where relevant -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-[var(--color-charcoal)]">
    <PageTransition client:load />
    <slot />
    <CookieConsent client:load transition:persist />
  </body>
</html>
